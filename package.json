    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "generate-password": "^1.7.0",
    "i18n": "^0.15.1",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
